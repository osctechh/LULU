<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Mi primer añito</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <audio
      id="background-music"
      src="/Diego Topa - GANAS DE APLAUDIR (Official Video).mp3"
      loop></audio>

    <div
      id="welcome-overlay"
      class="fixed inset-0 bg-gradient-to-br from-pink-500 to-pink-400 flex flex-col items-center justify-center z-[99999] cursor-pointer p-4"
    >
      <h1
        class="font-[Pacifico] text-2xl md:text-3xl text-white mb-4 text-center"
      >
        🎉 Mi Primer Añito 🎉
      </h1>
      <p
        class="font-[Quicksand] text-base md:text-xl text-white mb-8 text-center"
      >
        Haz clic para entrar a la fiesta
      </p>
      <div class="text-4xl md:text-6xl animate-bounce">👶</div>
    </div>

    <div
      class="fixed bottom-4 right-4 md:bottom-6 md:right-6 bg-pink-500 p-4 rounded-full flex items-center gap-4 shadow-lg shadow-pink-500/40 z-[10000]"
    >
      <button
        id="music-toggle"
        class="bg-white border-none rounded-full w-10 h-10 md:w-12 md:h-12 text-xl md:text-2xl cursor-pointer hover:scale-110 transition-transform"
      >
        🔇
      </button>
      <input
        type="range"
        id="volume-control"
        class="w-20 md:w-24 cursor-pointer"
        min="0"
        max="1"
        step="0.1"
        value="0.5"
      />
    </div>

    <slot />

    <script is:inline>
      const audio = document.getElementById("background-music");
      const toggleButton = document.getElementById("music-toggle");
      const volumeControl = document.getElementById("volume-control");
      const welcomeOverlay = document.getElementById("welcome-overlay");

      if (audio && toggleButton && volumeControl && welcomeOverlay) {
        // Configurar volumen inicial
        audio.volume = 0.5;

        // Manejar el overlay de bienvenida
        welcomeOverlay.addEventListener("click", () => {
          audio.play();
          welcomeOverlay.style.display = "none";
          toggleButton.textContent = "🎵";
        });

        // Toggle play/pause
        toggleButton.addEventListener("click", () => {
          if (audio.paused) {
            audio.play();
            toggleButton.textContent = "🎵";
          } else {
            audio.pause();
            toggleButton.textContent = "🔇";
          }
        });

        // Control de volumen
        volumeControl.addEventListener("input", (e) => {
          audio.volume = parseFloat(e.target.value);
        });
      }
    </script>
  </body>
</html>
