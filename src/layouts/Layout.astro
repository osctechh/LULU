<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Mi primer añito</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <audio
      id="background-music"
      src="/Diego Topa - GANAS DE APLAUDIR (Official Video).mp3"
      loop></audio>

    <div
      id="welcome-overlay"
      style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(135deg, #ec4899, #f472b6); display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 99999; cursor: pointer;"
    >
      <h1
        style="font-family: 'Pacifico', cursive; font-size: 3rem; color: white; margin-bottom: 1rem; text-align: center;"
      >
        🎉 Mi Primer Añito 🎉
      </h1>
      <p
        style="font-family: 'Quicksand', sans-serif; font-size: 1.5rem; color: white; margin-bottom: 2rem;"
      >
        Haz clic para entrar a la fiesta
      </p>
      <div style="font-size: 4rem; animation: bounce 1s ease-in-out infinite;">
        👶
      </div>
    </div>

    <div
      class="music-control"
      style="position: fixed; bottom: 20px; right: 20px; background: #ec4899; padding: 1rem; border-radius: 2rem; display: flex; align-items: center; gap: 1rem; box-shadow: 0 4px 12px rgba(236, 72, 153, 0.4); z-index: 10000;"
    >
      <button
        id="music-toggle"
        class="music-button"
        style="background: white; border: none; border-radius: 50%; width: 40px; height: 40px; font-size: 1.25rem; cursor: pointer;"
      >
        🔇
      </button>
      <input
        type="range"
        id="volume-control"
        class="volume-slider"
        min="0"
        max="1"
        step="0.1"
        value="0.5"
        style="width: 100px; cursor: pointer;"
      />
    </div>

    <slot />

    <script is:inline>
      const audio = document.getElementById("background-music");
      const toggleButton = document.getElementById("music-toggle");
      const volumeControl = document.getElementById("volume-control");
      const welcomeOverlay = document.getElementById("welcome-overlay");

      if (audio && toggleButton && volumeControl && welcomeOverlay) {
        // Configurar volumen inicial
        audio.volume = 0.5;

        // Manejar el overlay de bienvenida
        welcomeOverlay.addEventListener("click", () => {
          audio.play();
          welcomeOverlay.style.display = "none";
          toggleButton.textContent = "🎵";
        });

        // Toggle play/pause
        toggleButton.addEventListener("click", () => {
          if (audio.paused) {
            audio.play();
            toggleButton.textContent = "🎵";
          } else {
            audio.pause();
            toggleButton.textContent = "🔇";
          }
        });

        // Control de volumen
        volumeControl.addEventListener("input", (e) => {
          audio.volume = parseFloat(e.target.value);
        });
      }
    </script>
  </body>
</html>
