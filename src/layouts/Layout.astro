<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Mi primer añito</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <audio
      id="background-music"
      src="/Diego Topa - GANAS DE APLAUDIR (Official Video).mp3"
      loop
      autoplay></audio>

    <div
      class="music-control"
      style="position: fixed; bottom: 20px; right: 20px; background: #ec4899; padding: 1rem; border-radius: 2rem; display: flex; align-items: center; gap: 1rem; box-shadow: 0 4px 12px rgba(236, 72, 153, 0.4); z-index: 10000;"
    >
      <button
        id="music-toggle"
        class="music-button"
        style="background: white; border: none; border-radius: 50%; width: 40px; height: 40px; font-size: 1.25rem; cursor: pointer;"
      >
        🎵
      </button>
      <input
        type="range"
        id="volume-control"
        class="volume-slider"
        min="0"
        max="1"
        step="0.1"
        value="0.5"
        style="width: 100px; cursor: pointer;"
      />
    </div>

    <slot />

    <script is:inline>
      console.log("Music control script loaded");
      const audio = document.getElementById("background-music");
      const toggleButton = document.getElementById("music-toggle");
      const volumeControl = document.getElementById("volume-control");

      console.log("Audio:", audio);
      console.log("Button:", toggleButton);
      console.log("Volume:", volumeControl);

      if (audio && toggleButton && volumeControl) {
        // Configurar volumen inicial
        audio.volume = 0.5;

        // Toggle play/pause
        toggleButton.addEventListener("click", () => {
          if (audio.paused) {
            audio.play();
            toggleButton.textContent = "🎵";
          } else {
            audio.pause();
            toggleButton.textContent = "🔇";
          }
        });

        // Control de volumen
        volumeControl.addEventListener("input", (e) => {
          audio.volume = parseFloat(e.target.value);
        });
      }
    </script>
  </body>
</html>
