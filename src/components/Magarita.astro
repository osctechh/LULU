---
import margaritaSrc from "../assets/Margarita.svg?url";
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div class={`flex flex-col items-center ${className}`}>
  <div class="flex gap-20">
    <img src={margaritaSrc} alt="" class="margarita-img opacity-60" />
    <img
      src={margaritaSrc}
      alt=""
      class="margarita-img margarita-yellow opacity-60"
    />
    <img src={margaritaSrc} alt="" class="margarita-img opacity-60" />
  </div>
</div>

<style>
  .margarita-img {
    width: 200px;
    height: auto;
  }

  .margarita-yellow {
    filter: sepia(1) saturate(5) hue-rotate(5deg);
  }

  .margarita-margin-top {
    margin-top: 2rem;
  }
</style>
