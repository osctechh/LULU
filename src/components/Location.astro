---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div class={`invitation-section ${className}`}>
  <div class="invitation-card fade-in px-4 md:px-8">
    <h2 class="invitation-title">¡Te esperamos!</h2>
    <p class="invitation-subtitle">
      Ven a celebrar este día especial con nosotros
    </p>

    <div class="location-details">
      <div class="location-item">
        <span class="location-icon text-2xl md:text-3xl">📅</span>
        <div class="location-info">
          <p class="location-label text-xs md:text-sm">Fecha</p>
          <p class="location-value text-sm md:text-base">Sábado 15 de AGOSTO</p>
        </div>
      </div>

      <div class="location-item">
        <span class="location-icon text-2xl md:text-3xl">⏰</span>
        <div class="location-info">
          <p class="location-label text-xs md:text-sm">Hora</p>
          <p class="location-value text-sm md:text-base">14:30hs - 17:30hs</p>
        </div>
      </div>

      <div class="location-item">
        <span class="location-icon text-2xl md:text-3xl">📍</span>
        <div class="location-info">
          <p class="location-label text-xs md:text-sm">Lugar</p>
          <p class="location-value text-sm md:text-base">
            Salón de Fiestas "KARAMBA"
          </p>
        </div>
      </div>
    </div>

    <div class="map-container">
      <a
        href="https://www.google.com/maps/search/?api=1&query=Salón+de+Fiestas+Los+Peques"
        target="_blank"
        rel="noopener noreferrer"
        class="map-link"
      >
        <div class="map-placeholder">
          <div class="map-icon text-3xl md:text-4xl">🗺️</div>
          <p class="map-text text-lg md:text-xl">Click para ver el mapa</p>
          <p class="map-subtext text-sm md:text-base">Cómo llegar</p>
        </div>
      </a>
    </div>

    <div class="rsvp-section">
      <p class="rsvp-text text-xs md:text-sm">
        Por favor confirmar asistencia antes del 10 de Enero
      </p>
      <a
        href="https://wa.me/+5492954550225?text=Hola, quiero confirmar mi asistencia al cumpleaños"
        target="_blank"
        rel="noopener noreferrer"
        class="rsvp-button text-sm md:text-base"
      >
        📞 Confirmar por WhatsApp
      </a>
    </div>
  </div>
</div>

<style>
  .location-details {
    margin: 1.5rem 0;
  }

  @media (min-width: 768px) {
    .location-details {
      margin: 2rem 0;
    }
  }

  .location-item {
    display: flex;
    align-items: center;
    margin-bottom: 1rem;
    padding: 0.75rem;
    background: var(--background-dark);
    border-radius: 0.5rem;
  }

  @media (min-width: 768px) {
    .location-item {
      margin-bottom: 1.5rem;
      padding: 1rem;
      border-radius: 0.75rem;
    }
  }

  .location-icon {
    font-size: 1.5rem;
    margin-right: 0.75rem;
  }

  @media (min-width: 768px) {
    .location-icon {
      font-size: 2rem;
      margin-right: 1rem;
    }
  }

  .location-info {
    flex: 1;
  }

  .location-label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--text-light);
    margin-bottom: 0.25rem;
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .location-label {
      font-size: 0.875rem;
    }
  }

  .location-value {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--text-color);
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .location-value {
      font-size: 1rem;
    }
  }

  .map-container {
    margin: 1.5rem 0;
  }

  @media (min-width: 768px) {
    .map-container {
      margin: 2rem 0;
    }
  }

  .map-link {
    display: block;
    text-decoration: none;
  }

  .map-placeholder {
    background: linear-gradient(
      135deg,
      var(--primary-color),
      var(--secondary-color)
    );
    border-radius: 0.75rem;
    padding: 1.5rem;
    text-align: center;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    cursor: pointer;
  }

  @media (min-width: 768px) {
    .map-placeholder {
      border-radius: 1rem;
      padding: 2rem;
    }
  }

  .map-placeholder:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(236, 72, 153, 0.3);
  }

  .map-icon {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
  }

  @media (min-width: 768px) {
    .map-icon {
      font-size: 3rem;
      margin-bottom: 1rem;
    }
  }

  .map-text {
    font-family: var(--font-festive);
    font-size: 1.25rem;
    color: white;
    margin-bottom: 0.5rem;
  }

  @media (min-width: 768px) {
    .map-text {
      font-size: 1.5rem;
    }
  }

  .map-subtext {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.9);
  }

  @media (min-width: 768px) {
    .map-subtext {
      font-size: 1rem;
    }
  }

  .rsvp-section {
    margin-top: 1.5rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .rsvp-section {
      margin-top: 2rem;
    }
  }

  .rsvp-text {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--text-light);
    margin-bottom: 0.75rem;
  }

  @media (min-width: 768px) {
    .rsvp-text {
      font-size: 0.875rem;
      margin-bottom: 1rem;
    }
  }

  .rsvp-button {
    display: inline-block;
    background: var(--success-color);
    color: white;
    padding: 0.625rem 1.25rem;
    border-radius: 2rem;
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 600;
    transition:
      background 0.3s ease,
      transform 0.3s ease;
  }

  @media (min-width: 768px) {
    .rsvp-button {
      padding: 0.75rem 1.5rem;
    }
  }

  .rsvp-button:hover {
    background: #059669;
    transform: scale(1.05);
  }
</style>
